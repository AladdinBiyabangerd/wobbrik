+/** A quiet garden backdrop from the shipped atlas, behind the real building layers.
+ * Shares prepared art; no new bitmap, ownership decoration or animated frame state. */
+@Composable
+internal fun MarketBuildingPreview(building: appbackend.wobbrik.game.OwnedBuilding, modifier: Modifier) {
+    val ready = LocalBuildingArt.current.status == ArtPreparation.Ready
+    val foliage = if(ready) rememberPurpleBuildingArt()["front_left"] else null
+    Box(modifier.clipToBounds()) {
+        if(ready) Canvas(Modifier.matchParentSize()) {
+            // A low, diffuse pool of warm light ties the flowers and masonry to the card.
+            val ground = androidx.compose.ui.geometry.Offset(size.width * .5f, size.height * .88f)
+            withTransform({
+                scale(1f, .30f, ground)
+            }) {
+                drawCircle(Brush.radialGradient(listOf(GameTokens.MobileHome.GoldLight.copy(alpha=.24f),
+                    GameTokens.MobileHome.GoldLight.copy(alpha=0f)), ground, size.width * .47f),
+                    size.width * .47f, ground)
+            }
+            // Low-contrast distant shrubs flank the tower instead of widening its geometry.
+            sprite(foliage, size.width * .06f, size.height * .66f, size.width * .34f, size.height * .24f, .32f)
+            sprite(foliage, size.width * .60f, size.height * .68f, size.width * .29f, size.height * .21f, .24f)
+        }
+        BuildingPreview(building, Modifier.matchParentSize())
+    }
+}
